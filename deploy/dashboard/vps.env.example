# Vorlage für deploy/dashboard/vps.env (gitignored). Kopieren und anpassen:
#   cp deploy/dashboard/vps.env.example deploy/dashboard/vps.env
# Hier stehen nur Zugangsdaten zum VPS, keine Secrets des Dashboards. Die .env des Dashboards
# auf dem VPS und die Caddy-Konfiguration fasst das Skript nie an.

VPS_HOST=vps.example.org
VPS_USER=deploy
VPS_PORT=22
# Optional: privater SSH-Schlüssel (leer = ssh-agent bzw. Standard)
VPS_SSH_KEY=
# Absoluter Pfad auf dem VPS. Dort liegen die Compose-Datei und die .env; das Skript legt src, src.new, src.prev an.
REMOTE_DIR=/srv/spec-agent-dashboard
# Name des Compose-Projekts und des Dienstes (siehe compose.snippet.yml)
COMPOSE_PROJECT=stack
COMPOSE_SERVICE=spec-agent-dashboard
# Optional: Compose-Datei relativ zu REMOTE_DIR (Default: docker-compose.yml)
COMPOSE_FILE=docker-compose.yml
