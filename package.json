{
  "name": "spec-agent-kit",
  "private": true,
  "version": "0.5.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "echo 'Run apps individually'",
    "lint": "pnpm -r lint && uv run --project packages/engine ruff check packages/engine",
    "test": "pnpm -r test && uv run --project packages/engine pytest",
    "dashboard:local": "node apps/dashboard-api/scripts/local.mjs",
    "dashboard:project": "node apps/dashboard-api/scripts/local.mjs project",
    "board:build": "pnpm --filter @sak/dashboard-web run build:local",
    "board:check": "node apps/dashboard-web/scripts/board-check.mjs",
    "contracts:gen": "pnpm --filter @sak/contracts run gen",
    "contracts:check": "pnpm --filter @sak/contracts run check"
  }
}
